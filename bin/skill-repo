#!/usr/bin/env bash
# skill-repo — per-project Roo skill linking from the skills hub.
# Layout, grammar and trust rules: see README.md in the hub root.
#
# Internal note: all internal record lines use '|' as field separator
# (NOT tab) — IFS-whitespace delimiters collapse adjacent separators and
# silently drop empty fields.
set -euo pipefail

HUB="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
SOURCES_YML="$HUB/sources.yml"
SOURCES_TEMPLATE="$HUB/sources.template.yml"
GLOBAL_SKILLS="$HOME/.roo/skills"
FINDER="skill-hub-handling"
FS='|'

die()      { echo "skill-repo: error: $*" >&2; exit 1; }
conflict() { echo "skill-repo: conflict: $*" >&2; exit 2; }
warn()     { echo "skill-repo: warning: $*" >&2; }
info()     { echo "skill-repo: $*"; }

usage() {
  cat <<'EOF'
skill-repo — link Roo skills from the hub into this project

Commands (run from a project dir unless noted):
  setup [--personal <url>] [--shared <name>[=<url>]] (run in hub)
  attach <name> <url>     (run in hub) wire a source to its real remote —
                                           clone if missing, adopt an untouched
                                           scaffold, refuse real content
  link [--prune] [--force] [--allow-untrusted]
  list
  search <term>
  verify
  update
  add-remote <url> [--name NAME] [--root PATH]
  promote [--force] <ref|path> <source>/<category>   (any dir)
                                          copy a skill into a content repo,
                                          scan + stage it — commit is yours
  where [<ref>] [--prune]              (anywhere) reverse lookup: which
                                          projects link a skill (or, without
                                          a ref, all known consumers)
EOF
}

# ---------------------------------------------------------------- registry
# parse_sources <file> -> lines: name|path|root|remote|untrusted

parse_sources() {
  awk '
    function flush() { if (name != "") printf "%s|%s|%s|%s|%s\n", name, path, root, remote, untrusted }
    /^sources:/ { insrc = 1; next }
    insrc && /^[^[:space:]#]/ { insrc = 0 }
    insrc {
      line = $0
      sub(/[[:space:]]+#.*$/, "", line)
      sub(/[[:space:]]+$/, "", line)
      if (line ~ /^[[:space:]]*-[[:space:]]*name:/) {
        flush(); name = path = root = remote = ""; untrusted = "false"
        sub(/^[[:space:]]*-[[:space:]]*name:[[:space:]]*/, "", line); name = line
      } else if (line ~ /^[[:space:]]+path:/)      { sub(/^[[:space:]]+path:[[:space:]]*/, "", line);      path = line }
        else if (line ~ /^[[:space:]]+root:/)      { sub(/^[[:space:]]+root:[[:space:]]*/, "", line);      root = line }
        else if (line ~ /^[[:space:]]+remote:/)    { sub(/^[[:space:]]+remote:[[:space:]]*/, "", line);    remote = line }
        else if (line ~ /^[[:space:]]+untrusted:/) { sub(/^[[:space:]]+untrusted:[[:space:]]*/, "", line); untrusted = (line ~ /^[Tt]/) ? "true" : "false" }
    }
    END { flush() }
  ' "$1"
}

load_sources() {
  [ -f "$SOURCES_YML" ] || die "no sources.yml in hub — run 'skill-repo setup' in $HUB first"
  SRC_LINES="$(parse_sources "$SOURCES_YML")"
  [ -n "$SRC_LINES" ] || die "sources.yml contains no sources"
}

is_source_name() {
  [ -n "$1" ] || return 1
  local n
  while IFS="$FS" read -r n _; do [ "$n" = "$1" ] && return 0; done <<< "$SRC_LINES"
  return 1
}

# ---------------------------------------------------------------- index
# lines: source|category|id|untrusted|description|path

build_index() {
  INDEX="$(while IFS="$FS" read -r name path root remote untrusted; do
    [ -n "${name:-}" ] || continue
    root="${root:-.}"; root="${root%/}"
    base="$HUB/$path"
    if [ ! -d "$base" ]; then
      echo "skill-repo: warning: source '$name': missing dir $base (setup/add-remote)" >&2
      continue
    fi
    scanroot="$base"
    [ "$root" != "." ] && scanroot="$base/$root"
    if [ ! -d "$scanroot" ]; then
      echo "skill-repo: warning: source '$name': root '$root' not found" >&2
      continue
    fi
    while IFS= read -r d; do
      rel="${d#./}"
      [ -z "$rel" ] && continue
      id="${rel##*/}"
      catpath="$(dirname "$rel")"; [ "$catpath" = "." ] && catpath=""
      desc="$(grep -m1 '^description:' "$scanroot/$d/SKILL.md" 2>/dev/null \
              | sed -e 's/^description:[[:space:]]*//' -e 's/^"//' -e 's/"[[:space:]]*$//' | cut -c1-110)"
      printf '%s|%s|%s|%s|%s|%s\n' "$name" "$catpath" "$id" "${untrusted:-false}" "${desc:-}" "$scanroot/$rel"
    done < <(cd "$scanroot" && find . \( -name node_modules -o \( -name '.*' ! -name '.' \) \) -prune \
             -o -type d -exec test -f '{}/SKILL.md' ';' -prune -print)
  done <<< "$SRC_LINES")"
}

# ---------------------------------------------------------------- manifest

read_manifest() {
  MANIFEST=".roo/skills.yml"
  [ -f "$MANIFEST" ] || die "no $MANIFEST in $(pwd)"
  DEFAULT_SOURCE=""; CATS=(); SKILLS=(); EXCLUDES=()
  local section=""
  local line rest
  while IFS= read -r line || [ -n "$line" ]; do
    line="${line%%#*}"
    line="${line//\"/}"
    line="$(printf '%s' "$line" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
    [ -z "$line" ] && continue
    case "$line" in
      source:*)
        DEFAULT_SOURCE="$(printf '%s' "${line#source:}" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')" ;;
      categories:*)
        rest="$(printf '%s' "${line#categories:}" | tr -d ' ')"; section=cats
        [ -n "$rest" ] && [ "$rest" != "[]" ] && warn "manifest: inline lists not supported: $line" ;;
      skills:*)
        rest="$(printf '%s' "${line#skills:}" | tr -d ' ')"; section=skills
        [ -n "$rest" ] && [ "$rest" != "[]" ] && warn "manifest: inline lists not supported: $line" ;;
      exclude:*)
        rest="$(printf '%s' "${line#exclude:}" | tr -d ' ')"; section=excl
        [ -n "$rest" ] && [ "$rest" != "[]" ] && warn "manifest: inline lists not supported: $line" ;;
      -*)
        rest="$(printf '%s' "${line#-}" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
        [ -z "$rest" ] && continue
        case "$section" in
          cats)   CATS+=("$rest") ;;
          skills) SKILLS+=("$rest") ;;
          excl)   EXCLUDES+=("$rest") ;;
          *)      warn "manifest: list item outside a section: $line" ;;
        esac ;;
      *) warn "manifest: unrecognized line: $line" ;;
    esac
    :
  done < "$MANIFEST"
}

# ---------------------------------------------------------------- resolution
# RESULT: lines "linkname|source|category|path"

resolve() {
  SEL_TMP="$(mktemp)"; ALIAS_TMP="$(mktemp)"
  RESULT=""

  local -A used=()

  absorb_matches() { # $1=matched index lines, $2=alias (optional), $3=origin ref
    local ln s c i u d p
    while IFS="$FS" read -r s c i u d p; do
      [ -n "${s:-}" ] || continue
      ln="${2:-$i}"
      if [ -n "${used[$ln]:-}" ] && [ "${used[$ln]}" != "$s:$p" ]; then
        conflict "link name '$ln' used twice ('${used[$ln]}' and '$s:$p') — add an 'as' alias (ref: $3)"
      fi
      used["$ln"]="$s:$p"
      printf '%s|%s|%s|%s|%s|%s\n' "$s" "$c" "$i" "$u" "$d" "$p" >> "$SEL_TMP"
      if [ -n "${2:-}" ]; then
        printf 'ALIAS|%s|%s\n' "$i" "$2" >> "$ALIAS_TMP"
      fi
    done <<< "$1"
  }

  local ref first src path m ns id cat alias

  for ref in "${CATS[@]:-}"; do
    [ -z "$ref" ] && continue
    src=""; path="$ref"; first="${ref%%/*}"
    if is_source_name "$first"; then src="$first"; path="${ref#*/}"; fi
    if [ -n "$src" ] && [ "$path" = "$ref" ]; then
      conflict "category ref '$ref' needs a category path after the source"
    fi
    [ -z "$src" ] && [ -n "$DEFAULT_SOURCE" ] && src="$DEFAULT_SOURCE"
    m="$(printf '%s\n' "$INDEX" | awk -F"$FS" -v s="$src" -v c="$path" '(s != "") && ($1 == s) && ($2 == c)')"
    if [ -z "$m" ]; then
      [ -z "$src" ] && m="$(printf '%s\n' "$INDEX" | awk -F"$FS" -v c="$path" '$2 == c')"
      [ -z "$m" ] && die "category '$ref' not found in any source (try: skill-repo search $path)"
    fi
    if [ -z "$src" ]; then
      ns="$(printf '%s\n' "$m" | awk -F"$FS" '{print $1}' | sort -u | wc -l)"
      [ "$ns" -gt 1 ] && conflict "category '$ref' is ambiguous across sources: $(printf '%s\n' "$m" | awk -F"$FS" '{print $1}' | sort -u | paste -sd, -)"
    fi
    if [ "$ALLOW_UNTRUSTED" != 1 ] && printf '%s\n' "$m" | awk -F"$FS" '$4 == "true"' | grep -q .; then
      conflict "category '$ref' selects from an untrusted source — pick individual skills instead (or --allow-untrusted)"
    fi
    absorb_matches "$m" "" "$ref"
  done

  for ref in "${SKILLS[@]:-}"; do
    [ -z "$ref" ] && continue
    alias=""
    case "$ref" in
      *" as "*)
        alias="${ref##* as }"; alias="$(printf '%s' "$alias" | sed 's/[[:space:]]//g')"
        ref="${ref%% as *}" ;;
    esac
    src=""; path="$ref"; first="${ref%%/*}"
    if is_source_name "$first"; then src="$first"; path="${ref#*/}"; fi
    [ -z "$src" ] && [ -n "$DEFAULT_SOURCE" ] && src="$DEFAULT_SOURCE"
    id="${path##*/}"
    cat="${path%/*}"; [ "$cat" = "$path" ] && cat=""
    if [ -n "$src" ]; then
      m="$(printf '%s\n' "$INDEX" | awk -F"$FS" -v s="$src" -v i="$id" '($1 == s) && ($3 == i)')"
      [ -z "$m" ] && die "skill '$ref' not found in source '$src' (try: skill-repo search $id)"
      ns="$(printf '%s\n' "$m" | wc -l)"
      [ "$ns" -gt 1 ] && conflict "skill '$ref' matches $ns skills in '$src' — qualify the category path:
$m"
    else
      m="$(printf '%s\n' "$INDEX" | awk -F"$FS" -v i="$id" '$3 == i')"
      [ -z "$m" ] && die "skill '$ref' not found in any source (try: skill-repo search $id)"
      ns="$(printf '%s\n' "$m" | awk -F"$FS" '{print $1}' | sort -u | wc -l)"
      [ "$ns" -gt 1 ] && conflict "skill '$ref' is ambiguous across sources:
$m"
    fi
    absorb_matches "$m" "$alias" "$ref"
  done

  for ref in "${EXCLUDES[@]:-}"; do
    [ -z "$ref" ] && continue
    src=""; path="$ref"; first="${ref%%/*}"
    if is_source_name "$first"; then src="$first"; path="${ref#*/}"; fi
    [ -z "$src" ] && [ -n "$DEFAULT_SOURCE" ] && src="$DEFAULT_SOURCE"
    id="${path##*/}"; cat="${path%/*}"; [ "$cat" = "$path" ] && cat=""
    awk -F"$FS" -v s="$src" -v c="$cat" -v i="$id" \
      '(s != "" && $1 != s) || (c != "" && $2 != c) || (i != "" && $3 != i)' "$SEL_TMP" > "$SEL_TMP.keep" || true
    mv "$SEL_TMP.keep" "$SEL_TMP"
  done

  local -A seen=()
  local s c i u d p ln
  while IFS="$FS" read -r s c i u d p; do
    [ -n "${s:-}" ] || continue
    [ -n "${seen[$p]:-}" ] && continue
    seen["$p"]=1
    ln="$i"
    if grep -qF "ALIAS|$i|" "$ALIAS_TMP" 2>/dev/null; then
      ln="$(grep -F "ALIAS|$i|" "$ALIAS_TMP" | head -1 | cut -d"$FS" -f3)"
    fi
    ln="$ln.hub"   # marker suffix: one committed ignore pattern covers all links
    RESULT="${RESULT}$(printf '%s|%s|%s|%s\n' "$ln" "$s" "$c" "$p")
"
  done < <(sort -u -t"$FS" -k6,6 "$SEL_TMP")
  rm -f "$SEL_TMP" "$ALIAS_TMP"
  [ -n "$RESULT" ] || info "manifest resolves to zero skills — nothing to link"
}

# ---------------------------------------------------------------- commands

cmd_link() {
  load_sources; build_index; read_manifest; resolve
  local n=0
  mkdir -p .roo/skills
  local lock=".roo/skills.lock"
  local tmp="$lock.tmp"
  echo "# generated by skill-repo link $(date -u +%Y-%m-%dT%H:%M:%SZ) — do not edit" > "$tmp"
  local lnk src cat path dest rel commit ts aliased
  while IFS="$FS" read -r lnk src cat path; do
    [ -n "${lnk:-}" ] || continue
    dest=".roo/skills/$lnk"
    if [ -L "$dest" ]; then
      :
    elif [ -e "$dest" ]; then
      if [ "$FORCE" != 1 ]; then
        rm -f "$tmp"
        die "$dest exists and is not a hub link — rerun with --force to move it aside"
      fi
      ts="$(date +%Y%m%d%H%M%S)"
      mv "$dest" "$dest.pre-hub-$ts"
      warn "moved aside: $dest -> $dest.pre-hub-$ts"
    fi
    rel="$(realpath --relative-to=".roo/skills" "$path")"
    ln -sfn "$rel" "$dest"
    commit="-"
    if commit="$(git -C "$path" rev-parse --short=7 HEAD 2>/dev/null)"; then
      if [ -n "$(git -C "$path" status --porcelain -- "$path" 2>/dev/null)" ]; then
        commit="$commit-dirty"
      fi
    else
      commit="-"
    fi
    aliased=false
    [ "${lnk%.hub}" != "$(basename "$path")" ] && aliased=true
    printf '%s:\n  source: %s\n  category: %s\n  path: %s\n  commit: %s\n  aliased: %s\n' \
      "$lnk" "$src" "${cat:-.}" "${path#"$HUB"/}" "$commit" "$aliased" >> "$tmp"
    n=$((n+1))
  done <<< "$RESULT"
  mv "$tmp" "$lock"

  if [ "$PRUNE" = 1 ]; then
    local names l t name
    names="$(printf '%s' "$RESULT" | cut -d"$FS" -f1)"
    for l in .roo/skills/*; do
      [ -L "$l" ] || continue
      t="$(readlink -f "$l" 2>/dev/null)" || continue
      case "$t" in "$HUB"/*) ;; *) continue ;; esac
      name="$(basename "$l")"
      if ! printf '%s\n' "$names" | grep -qxF "$name"; then
        unlink "$l"; info "pruned: $name"
      fi
    done
  fi
  info "linked $n skill(s) -> .roo/skills (lock: .roo/skills.lock)"
  link_ignore_pattern
  link_roots_register
}

link_ignore_pattern() { # ensure '<skills-rel>/*.hub' is gitignored (committed line)
  git rev-parse --show-toplevel > /dev/null 2>&1 || return 0
  local root rel
  root="$(git rev-parse --show-toplevel)"
  rel="$(realpath --relative-to="$root" .roo/skills)"
  grep -qxF "${rel}/*.hub" .gitignore 2>/dev/null && return 0
  { [ -s .gitignore ] && echo; printf '# skills hub links (marker suffix)\n%s/*.hub\n' "$rel"; } >> .gitignore
  info "added '${rel}/*.hub' to .gitignore (commit this line)"
}

# ------------------------------------------------------------ link roots
# Hints-only registry of projects that linked from this hub (hub-local,
# gitignored, one absolute project path per line). The lockfiles are the
# truth; this list only says where to look.

link_roots_register() {
  local roots="$HUB/.link-roots" proj
  proj="$(pwd)"
  touch "$roots"
  if grep -qxF "$proj" "$roots"; then :; else
    printf '%s\n' "$proj" >> "$roots"
    info "registered consumer in $roots"
  fi
}

cmd_list() {
  load_sources; build_index
  if [ -f ".roo/skills.lock" ]; then
    sed -n '2,$p' .roo/skills.lock
  else
    info "no lockfile — nothing linked yet"
  fi
  if [ -f ".roo/skills.yml" ]; then
    read_manifest; resolve
    printf '%s' "$RESULT" | awk -F"$FS" -v hub="$HUB" \
      '{ sub("^" hub "/", "", $4); printf "%-28s <- %s/%s%s\n", $1, $2, ($3 == "" ? "" : $3 "/"), $4 }'
  fi
}

cmd_search() {
  [ -n "${1:-}" ] || die "usage: skill-repo search <term>"
  load_sources; build_index
  printf '%s\n' "$INDEX" | awk -F"$FS" -v t="${1,,}" '
    { low = tolower($1"/"$2"/"$3" "$5) }
    index(low, t) { printf "%-12s %-38s %s\n", $1, ($2 == "" ? $3 : $2"/"$3), substr($5, 1, 66) }
  ' || true
}

cmd_verify() {
  load_sources; build_index
  local fails=0
  local s c i u d p fmname
  while IFS="$FS" read -r s c i u d p; do
    [ -n "${s:-}" ] || continue
    if [ ! -f "$p/SKILL.md" ]; then
      echo "verify: missing SKILL.md: $p" >&2; fails=$((fails+1)); continue
    fi
    [ -n "$d" ] || warn "no description: $s/${c:+$c/}$i"
    fmname="$(grep -m1 '^name:' "$p/SKILL.md" 2>/dev/null | sed -e 's/^name:[[:space:]]*//' -e 's/"//g')"
    if [ -n "$fmname" ] && [ "$fmname" != "$i" ]; then
      warn "frontmatter name '$fmname' != dir id '$i' ($s/${c:+$c/}$i)"
    fi
  done <<< "$INDEX"

  if [ -f ".roo/skills.yml" ]; then
    read_manifest; resolve
    local names_tmp; names_tmp="$(mktemp)"
    local lnk src cat path
    while IFS="$FS" read -r lnk src cat path; do
      [ -n "${lnk:-}" ] || continue
      if [ ! -e ".roo/skills/$lnk/SKILL.md" ]; then
        echo "verify: broken or missing link: $lnk (run 'skill-repo link')" >&2; fails=$((fails+1))
      fi
      grep -m1 '^name:' "$path/SKILL.md" 2>/dev/null \
        | sed -e 's/^name:[[:space:]]*//' -e 's/"//g' >> "$names_tmp"
    done <<< "$RESULT"
    if [ "$(sort "$names_tmp" | uniq -d | wc -l)" -gt 0 ]; then
      echo "verify: duplicate frontmatter names in linked set (aliases cannot fix this):" >&2
      sort "$names_tmp" | uniq -d >&2
      fails=$((fails+1))
    fi
    rm -f "$names_tmp"
  fi
  if [ "$fails" -eq 0 ]; then info "verify: OK"; else
    echo "skill-repo: verify: $fails failure(s)" >&2; exit 3
  fi
}

ensure_repo() { # $1=relative dir, $2=optional url
  local dir="$HUB/$1" remote=""
  if [ -d "$dir/.git" ]; then
    remote="$(git -C "$dir" remote get-url origin 2>/dev/null || true)"
    if [ -n "$remote" ]; then
      info "setup: $1 exists (remote: $remote)"
    else
      info "setup: $1 exists (no remote)"
    fi
    return 0
  fi
  if [ -n "${2:-}" ]; then
    git clone "$2" "$dir" || die "clone failed: $2"
    info "setup: cloned $2 -> $1"
  else
    mkdir -p "$dir/skills"
    git -C "$dir" init -q -b main
    printf '# %s skills\n\nLayout: skills/<category>/<skill>/SKILL.md — see the hub README.\n' "$1" > "$dir/README.md"
    # NOTE: the commit message below is a behavioral contract —
    # is_untouched_scaffold (attach) detects scaffolds by it. Change both or neither.
    git -C "$dir" add -A && git -C "$dir" commit -qm "init: skills repo scaffold"
    info "setup: created $1/ (git repo, skills/ scaffold, initial commit)"
  fi
}

registry_append() { # $1=name $2=path [$3=remote] — rc 0: appended, rc 1: already registered
  if grep -qE "^[[:space:]]*-[[:space:]]*name:[[:space:]]*\"?${1}\"?[[:space:]]*$" "$SOURCES_YML" 2>/dev/null; then
    return 1
  fi
  printf '  - name: %s\n    path: %s\n    root: skills\n' "$1" "$2" >> "$SOURCES_YML"
  [ -n "${3:-}" ] && printf '    remote: %s\n' "$3" >> "$SOURCES_YML"
}

cmd_setup() {
  local personal_url="" t name url path root remote untrusted cnt note
  local shared_specs=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --personal) personal_url="${2:-}"; shift 2 ;;
      --shared)   shared_specs+=("${2:-}"); shift 2 ;;
      --team)     shared_specs+=("${2:-}"); shift 2 ;;   # legacy alias
      --force)    FORCE=1; shift ;;
      *) die "setup: unknown option: $1" ;;
    esac
  done

  ensure_repo personal "$personal_url"
  for t in "${shared_specs[@]}"; do
    name="${t%%=*}"; url=""
    if [[ "$t" == *=* ]]; then url="${t#*=}"; fi
    ensure_repo "shared/$name" "$url"
  done

  if [ ! -f "$SOURCES_YML" ]; then
    cp "$SOURCES_TEMPLATE" "$SOURCES_YML"
    info "setup: wrote sources.yml from sources.template.yml"
  fi
  while IFS="$FS" read -r n p _; do
    [ -n "${n:-}" ] || continue
    if registry_append "$n" "$p"; then info "setup: sources.yml: registered '$n' ($p)"; fi
  done <<< "$(parse_sources "$SOURCES_TEMPLATE")"
  for t in "${shared_specs[@]}"; do
    name="${t%%=*}"; url=""
    if [[ "$t" == *=* ]]; then url="${t#*=}"; fi
    if registry_append "$name" "shared/$name" "$url"; then info "setup: sources.yml: registered '$name' (shared/$name)"; fi
  done
  if registry_append personal personal; then info "setup: sources.yml: registered 'personal' (personal/)"; fi

  chmod +x "$0"
  mkdir -p "$GLOBAL_SKILLS"
  local dest="$GLOBAL_SKILLS/$FINDER"
  local target; target="$(realpath --relative-to="$GLOBAL_SKILLS" "$HUB/meta/skill-hub-handling")"
  if [ -L "$dest" ]; then
    ln -sfn "$target" "$dest"
    info "setup: refreshed global skill symlink: $dest"
  elif [ -e "$dest" ]; then
    if [ "$FORCE" = 1 ]; then
      local ts; ts="$(date +%Y%m%d%H%M%S)"
      mv "$dest" "$dest.pre-hub-$ts"; ln -s "$target" "$dest"
      warn "moved existing $FINDER aside ($dest.pre-hub-$ts)"
      info "setup: installed global skill: $dest"
    else
      warn "$dest exists and is not a symlink — not overwritten (rerun setup --force)"
    fi
  else
    ln -s "$target" "$dest"
    info "setup: installed global skill: $dest -> $HUB/meta/skill-hub-handling"
  fi

  info "setup: done. sources registered in sources.yml:"
  load_sources
  build_index
  while IFS="$FS" read -r name path root remote untrusted; do
    [ -n "${name:-}" ] || continue
    cnt="$(printf '%s\n' "$INDEX" | awk -F"$FS" -v s="$name" '$1 == s { n++ } END { print n + 0 }')"
    note=""
    [ -n "$remote" ] && note=", remote: $remote"
    [ "$untrusted" = "true" ] && note="$note, untrusted"
    info "  $name — $path ($cnt skill(s)$note)"
  done <<< "$SRC_LINES"
  info "next: 'skill-repo search <term>' to find skills, './start' for the web UI"
}

cmd_update() {
  load_sources
  local name path root remote untrusted dir
  while IFS="$FS" read -r name path root remote untrusted; do
    [ -n "${name:-}" ] || continue
    [ -n "${remote:-}" ] || continue
    dir="$HUB/$path"
    if [ ! -d "$dir/.git" ]; then warn "update: '$name' has remote but no clone at $dir"; continue; fi
    if ! git -C "$dir" diff --quiet HEAD 2>/dev/null \
       || [ -n "$(git -C "$dir" status --porcelain 2>/dev/null)" ]; then
      warn "update: '$name' is dirty — skipped"; continue
    fi
    if git -C "$dir" fetch --quiet 2>/dev/null && git -C "$dir" pull --ff-only --quiet 2>/dev/null; then
      info "update: $name updated"
    else
      warn "update: $name failed (fetch/ff-only) — skipped"
    fi
  done <<< "$SRC_LINES"
}

cmd_add_remote() {
  local url="" name="" root=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --name) name="${2:-}"; shift 2 ;;
      --root) root="${2:-}"; shift 2 ;;
      -*) die "add-remote: unknown option $1" ;;
      *)  [ -z "$url" ] && url="$1" || die "add-remote: unexpected arg $1"; shift ;;
    esac
  done
  [ -n "$url" ] || die "usage: skill-repo add-remote <url> [--name NAME] [--root PATH]"
  [ -n "$name" ] || { name="$(basename "$url" .git)"; name="${name//[^a-z0-9-]/-}"; }
  load_sources
  is_source_name "$name" && die "source '$name' already registered"
  local dir="$HUB/external/$name"
  [ -d "$dir" ] && die "$dir already exists"
  git clone --depth 1 "$url" "$dir" || die "clone failed"
  [ -z "$root" ] && { if [ -d "$dir/skills" ]; then root="skills"; else root="."; fi; }
  printf '  - name: %s\n    path: external/%s\n    root: %s\n    remote: %s\n    untrusted: true\n' \
    "$name" "$name" "$root" "$url" >> "$SOURCES_YML"
  info "added external source '$name' (root: $root) as UNTRUSTED. Skills found:"
  load_sources; build_index
  printf '%s\n' "$INDEX" | awk -F"$FS" -v s="$name" '$1 == s {printf "  %-38s %s\n", ($2 == "" ? $3 : $2"/"$3), substr($5, 1, 66)}'
}

# ---------------------------------------------------------------- attach
# Wire a source dir to its real remote (trusted — no untrusted flag; never pushes).

is_untouched_scaffold() { # $1=dir — an ensure_repo() scaffold: nothing to lose
  git -C "$1" rev-parse --git-dir >/dev/null 2>&1 || return 1
  [ -z "$(git -C "$1" remote)" ]                                          || return 1  # no remotes
  [ -z "$(git -C "$1" status --porcelain 2>/dev/null)" ]                  || return 1  # clean tree
  [ "$(git -C "$1" rev-list --count HEAD 2>/dev/null || echo 0)" -eq 1 ]  || return 1  # single commit
  [ "$(git -C "$1" log -1 --format=%s)" = "init: skills repo scaffold" ]  || return 1  # the scaffold commit
  [ -z "$(find "$1" -name .git -prune -o -type f -name SKILL.md -print -quit 2>/dev/null)" ] || return 1  # skills/ empty
  return 0
}

registry_set_remote() { # $1=name $2=remote — insert 'remote:' into an existing entry
  local tmp
  tmp="$(mktemp)"
  awk -v name="$1" -v remote="$2" '
    /^[[:space:]]*-[[:space:]]*name:/ {
      inent = ($0 ~ "-[[:space:]]*name:[[:space:]]*\"?" name "\"?[[:space:]]*$")
    }
    { print }
    inent && /^[[:space:]]*root:/ { printf "    remote: %s\n", remote; inent = 0 }
  ' "$SOURCES_YML" > "$tmp" && mv "$tmp" "$SOURCES_YML"
}

cmd_attach() { # $1=name $2=url
  local name="${1:-}" url="${2:-}"
  { [ -n "$name" ] && [ -n "$url" ]; } || die "usage: skill-repo attach <name> <url>"
  [ $# -le 2 ] || die "attach: unexpected argument(s): ${*:3}"
  [[ "$name" =~ ^[a-z0-9][a-z0-9._-]*$ ]] || die "attach: invalid name '$name' (allowed: lowercase, digits, . _ -)"
  [ -f "$SOURCES_YML" ] || die "no sources.yml in hub — run 'skill-repo setup' first"
  load_sources

  # dir: registered name -> its registered path (also enables 'attach personal');
  # unregistered name -> shared/<name>
  local path="" reg_remote="" registered=0 n p r rem unt
  while IFS="$FS" read -r n p r rem unt; do
    [ -n "${n:-}" ] || continue
    if [ "$n" = "$name" ]; then path="$p"; reg_remote="${rem:-}"; break; fi
  done <<< "$SRC_LINES"
  [ -n "$path" ] && registered=1
  [ -n "$reg_remote" ] && die "attach: source '$name' is already attached to $reg_remote"
  [ -z "$path" ] && path="shared/$name"

  local dir="$HUB/$path"

  # ---- dir missing: clone (unregistered names only)
  if [ ! -d "$dir" ]; then
    [ "$registered" = 1 ] && die "attach: '$name' is registered ($path) but $dir is missing — fix or remove the sources.yml entry"
    git clone "$url" "$dir" || die "attach: clone failed: $url"
    local root="."
    [ -d "$dir/skills" ] && root="skills"
    printf '  - name: %s\n    path: %s\n    root: %s\n    remote: %s\n' "$name" "$path" "$root" "$url" >> "$SOURCES_YML"
    info "attach: cloned $url -> $path, registered source '$name' (root: $root, trusted)"
    load_sources; build_index
    printf '%s\n' "$INDEX" | awk -F"$FS" -v s="$name" '$1 == s {printf "  %-38s %s\n", ($2 == "" ? $3 : $2"/"$3), substr($5, 1, 66)}'
    info "next: 'skill-repo update' pulls it (ff-only), 'skill-repo search <term>' finds its skills"
    return 0
  fi

  # ---- dir exists: must be a git repo without any remote
  git -C "$dir" rev-parse --git-dir >/dev/null 2>&1 || die "attach: $dir exists but is not a git repo"
  [ -z "$(git -C "$dir" remote)" ] || die "attach: $path already has remote(s): $(git -C "$dir" remote | paste -sd, -) — refusing (adjust manually if intended)"

  if ! is_untouched_scaffold "$dir"; then
    die "attach: $path has local content/history — refusing to touch it. If the remote is authoritative:
  git -C $path remote add origin $url
  git -C $path fetch origin && git -C $path reset --hard origin/<branch>
…or move $path aside and re-run attach (clone)."
  fi

  # ---- untouched scaffold: wire it — nothing to lose, no confirmation needed
  git -C "$dir" remote add origin "$url"
  git -C "$dir" fetch origin || die "attach: fetch failed for $url (origin was added — fix it or: git -C $path remote remove origin)"
  git -C "$dir" remote set-head origin --auto >/dev/null 2>&1 || true

  local branch="" branches nb
  branch="$(git -C "$dir" symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null | sed 's|^origin/||')" || true
  [ "$branch" = "HEAD" ] && branch=""
  if [ -z "$branch" ]; then
    branches="$(git -C "$dir" for-each-ref --format='%(refname:short)' refs/remotes/origin | sed 's|^origin/||' | grep -v '^HEAD$' || true)"
    nb="$(printf '%s\n' "$branches" | grep -c . || true)"
    if   [ "$nb" = "1" ]; then branch="$branches"
    elif printf '%s\n' "$branches" | grep -qx main;   then branch="main"
    elif printf '%s\n' "$branches" | grep -qx master; then branch="master"
    elif [ "$nb" = "0" ]; then
      die "attach: $url has no refs — nothing to attach. Pushing a local repo to a fresh remote is a manual, user-confirmed step (see skill-hub-handling). Origin was added; undo with: git -C $path remote remove origin"
    else
      die "attach: cannot determine the default branch of $url (candidates: $(printf '%s\n' "$branches" | paste -sd, -)) — wire it manually"
    fi
  fi

  local cur
  cur="$(git -C "$dir" rev-parse --abbrev-ref HEAD)"
  if [ "$cur" != "$branch" ]; then git -C "$dir" branch -m "$branch"; fi
  git -C "$dir" reset --hard -q "origin/$branch"
  git -C "$dir" branch --set-upstream-to="origin/$branch" "$branch" >/dev/null

  if [ "$registered" = 1 ]; then
    registry_set_remote "$name" "$url"
    info "attach: sources.yml: recorded remote for '$name' ($path)"
  else
    printf '  - name: %s\n    path: %s\n    root: skills\n    remote: %s\n' "$name" "$path" "$url" >> "$SOURCES_YML"
    info "attach: sources.yml: registered '$name' ($path) with remote"
  fi
  info "attach: $path wired to origin/$branch at $(git -C "$dir" rev-parse --short=7 HEAD), upstream set"
  info "next: 'skill-repo update' pulls it (ff-only), 'skill-repo search <term>' finds its skills"
}

promote_scan() { # $1=dir — trust-boundary content scan; sets SCAN_HITS
  local d="$1"; SCAN_HITS=0
  local out
  ps_one() { # $1=label $2=include-regex $3=exclude-regex(optional)
    out="$(grep -rInE -- "$2" "$d" 2>/dev/null || true)"
    if [ -n "${3:-}" ] && [ -n "$out" ]; then
      out="$(printf '%s\n' "$out" | grep -vE -- "$3" || true)"
    fi
    if [ -n "$out" ]; then
      SCAN_HITS=$(( SCAN_HITS + $(printf '%s\n' "$out" | wc -l) ))
      printf '%s\n' "$out" | sed -e "s|^$d/*||" -e "s|^|promote-scan [$1] |" >&2
    fi
  }
  ps_one credential '(sk-[A-Za-z0-9]{20,}|AKIA[0-9A-Z]{12,}|gh[pousr]_[A-Za-z0-9]{16,}|xox[baprs]-[A-Za-z0-9-]{10,})' ''
  ps_one cred-url   '[a-z][a-z0-9+.-]*://[^/@: ]+:[^/@ ]+@' ''
  ps_one email      '[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}' '(example\.|@test\.|\.noreply\.|xxx)'
  ps_one ip         '([0-9]{1,3}\.){3}[0-9]{1,3}' '(0\.0\.0\.0|127\.0\.0\.1|255\.255\.255\.255|8\.8\.8\.8|1\.1\.1\.1)'
  ps_one home-path  '/home/[A-Za-z0-9._-]+' '/home/django'
}

cmd_where() {
  local prune=0 ref=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --prune) prune=1; shift ;;
      -*)      die "where: unknown option $1" ;;
      *)       ref="$1"; shift ;;
    esac
  done
  local name=""
  [ -n "$ref" ] && name="${ref##*/}"
  local roots="$HUB/.link-roots"
  if [ ! -s "$roots" ]; then
    info "where: no consumers registered yet — projects register themselves on 'skill-repo link'"
    return 0
  fi
  local proj lock out found=0 stale=0 kept
  kept="$(mktemp)"
  while IFS= read -r proj; do
    [ -n "$proj" ] || continue
    lock="$proj/.roo/skills.lock"
    if [ ! -f "$lock" ]; then
      stale=$((stale+1))
      if [ "$prune" = 1 ]; then
        warn "where: pruning stale root: $proj"
      else
        warn "where: stale root (no lock — project moved/deleted?): $proj"
        printf '%s\n' "$proj" >> "$kept"
      fi
      continue
    fi
    printf '%s\n' "$proj" >> "$kept"
    if [ -n "$name" ]; then
      out="$(awk -v n="$name" '
        $0 == n ":" || $0 == n ".hub:" { inb = 1; next }
        inb && /^[^[:space:]]/ { inb = 0 }
        inb && /^  (source|category|path|commit|aliased):/ { print "    " $0 }
      ' "$lock")"
      if [ -n "$out" ]; then
        found=$((found+1))
        info "$proj"
        printf '%s\n' "$out"
      fi
    else
      info "$proj ($(grep -c '^[A-Za-z0-9][A-Za-z0-9-]*:' "$lock") skill(s))"
    fi
  done < "$roots"
  if [ "$prune" = 1 ]; then
    sort -u "$kept" > "$roots"
  fi
  rm -f "$kept"
  if [ -n "$name" ]; then
    if [ "$found" -eq 0 ]; then
      info "where: no project links '$name' (among $(wc -l < "$roots") registered)"
    else
      info "where: '$name' linked in $found project(s)"
    fi
  fi
}

cmd_promote() {
  local force=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --force) force=1; shift ;;
      -*)      die "promote: unknown option $1" ;;
      *)       break ;;
    esac
  done
  [ $# -eq 2 ] || die "usage: skill-repo promote [--force] <ref|path> <source>/<category>"
  local ref="$1" target="$2"
  load_sources; build_index

  # ---- source: a directory with SKILL.md, or a ref resolved via the index
  local srcdir="" m first path src id
  if [ -d "$ref" ]; then
    [ -f "$ref/SKILL.md" ] || die "promote: '$ref' is a directory but has no SKILL.md"
    srcdir="$(cd "$ref" && pwd)"
  else
    first="${ref%%/*}"; path="$ref"; src=""
    if is_source_name "$first"; then src="$first"; path="${ref#*/}"; fi
    id="${path##*/}"
    [ -n "$id" ] || die "promote: cannot derive a skill id from '$ref'"
    if [ -n "$src" ]; then
      m="$(printf '%s\n' "$INDEX" | awk -F"$FS" -v s="$src" -v i="$id" '($1 == s) && ($3 == i)')"
    else
      m="$(printf '%s\n' "$INDEX" | awk -F"$FS" -v i="$id" '$3 == i')"
    fi
    [ -n "$m" ] || die "promote: '$ref' is not a skill dir and not a known skill (try: skill-repo search ${ref##*/})"
    if [ "$(printf '%s\n' "$m" | wc -l)" -gt 1 ]; then
      conflict "promote: '$ref' matches several skills — qualify as <source>/<category>/<id>:
$m"
    fi
    srcdir="$(printf '%s\n' "$m" | awk -F"$FS" '{print $6}')"
  fi
  id="$(basename "$srcdir")"

  # ---- target: registered source + category path
  local tsrc="${target%%/*}" tcat=""
  if [ "$tsrc" != "$target" ]; then tcat="${target#*/}"; fi
  is_source_name "$tsrc" || die "promote: target source '$tsrc' is not registered (known: $(printf '%s\n' "$SRC_LINES" | cut -d"$FS" -f1 | paste -sd, -))"
  local tpath="" troot="." tuntrusted="false"
  while IFS="$FS" read -r n p r _rem unt; do
    if [ "$n" = "$tsrc" ]; then tpath="$HUB/$p"; troot="${r:-.}"; tuntrusted="$unt"; break; fi
  done <<< "$SRC_LINES"
  [ "$tuntrusted" = "true" ] && die "promote: '$tsrc' is an untrusted external clone — promote into personal/ or a shared repo"
  [ -d "$tpath/.git" ] || die "promote: target '$tsrc' is not a git repo ($tpath)"
  if [ -n "$tcat" ]; then
    local seg ok=1
    while IFS= read -r seg; do
      [[ "$seg" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || ok=0
    done < <(printf '%s\n' "$tcat" | tr '/' '\n')
    [ "$ok" = 1 ] || die "promote: invalid category '$tcat'"
  fi
  local scanroot="$tpath"; [ "$troot" != "." ] && scanroot="$tpath/$troot"
  local dest="$scanroot/$tcat/$id"
  local gitpath="$tcat/$id"; [ "$troot" != "." ] && gitpath="$troot/$gitpath"
  [ "$srcdir" = "$dest" ] && die "promote: source and target are the same directory"

  # ---- collision: refuse, or replace via git (history is the backup)
  if [ -e "$dest" ]; then
    if [ "$force" != 1 ]; then
      die "promote: '$tsrc/$tcat/$id' already exists — rerun with --force to replace (committed versions stay recoverable in git history)"
    fi
    if [ -n "$(git -C "$tpath" status --porcelain -- "$gitpath" 2>/dev/null || true)" ]; then
      # uncommitted local changes exist ONLY on disk — git cannot recover them
      local bts bdir
      bts="$(date +%Y%m%d%H%M%S)"
      bdir="$HUB/.promote-backup/$tsrc-$id-$bts"
      mkdir -p "$bdir"
      mv "$dest" "$bdir/"
      warn "promote: existing copy had UNCOMMITTED changes — backed up outside the repo: $bdir"
    else
      git -C "$tpath" rm -r -q -- "$gitpath"
      info "promote: replacing committed version — old state recoverable from git history"
    fi
  fi

  # ---- copy, scan, stage — commit/review stays with the human (spec 8.1)
  mkdir -p "$(dirname "$dest")"
  cp -a "$srcdir" "$dest"
  [ -f "$dest/SKILL.md" ] || die "promote: internal error — copy has no SKILL.md"
  promote_scan "$dest"
  git -C "$tpath" add "$gitpath"
  info "promoted: $id"
  info "  from:  $srcdir"
  info "  to:    ${tpath#"$HUB"/}/$gitpath (staged, NOT committed)"
  if [ "${SCAN_HITS:-0}" -gt 0 ]; then
    warn "promote: $SCAN_HITS content finding(s) printed above — review before committing (trust boundary: check secrets, emails, company terms, machine paths)"
  else
    info "scan:   no credential/email/IP/home-path findings"
  fi
  info "next:   git -C '${tpath#"$HUB"/}' diff --cached --stat  &&  git -C '${tpath#"$HUB"/}' commit"
}

# ---------------------------------------------------------------- main

FORCE=0; PRUNE=0; ALLOW_UNTRUSTED=0
CMD="${1:-}"; [ -n "$CMD" ] && shift
case "$CMD" in
  link)
    while [ $# -gt 0 ]; do
      case "$1" in
        --prune) PRUNE=1; shift ;;
        --force) FORCE=1; shift ;;
        --allow-untrusted) ALLOW_UNTRUSTED=1; shift ;;
        *) die "link: unknown option $1" ;;
      esac
    done
    cmd_link ;;
  list)       cmd_list "$@" ;;
  search)     cmd_search "$@" ;;
  verify)     cmd_verify ;;
  setup)      cmd_setup "$@" ;;
  update)     cmd_update ;;
  add-remote) cmd_add_remote "$@" ;;
  attach)     cmd_attach "$@" ;;
  promote)    cmd_promote "$@" ;;
  where)      cmd_where "$@" ;;
  -h|--help|help|'') usage ;;
  *) die "unknown command: $CMD (see --help)" ;;
esac
